# Copy values into your process environment; this file is documentation, not auto-loaded.
DEMO_MODE=1
HOST=127.0.0.1
PORT=8000
# Public local fixtures; use operator-managed PostgreSQL secrets and verified TLS when hosted.
DATABASE_URL=postgresql://blood_connection_app:local-development-runtime-only@127.0.0.1:5436/blood_connection
# Supply this only to db:migrate/db:import, not the long-running API.
MIGRATION_DATABASE_URL=postgresql://blood_connection_migrator:local-development-migration-only@127.0.0.1:5436/blood_connection
# Production must use DEMO_MODE=0, HTTPS at a reverse proxy, and these settings.
SUPABASE_URL=
SUPABASE_ANON_KEY=
ENABLED_COUNTRIES=BD,AU
ADMIN_USER_IDS=
# Browser origins must be explicit; never allow arbitrary origins with bearer credentials.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# Calls fail clearly until a real LiveKit service is configured.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# UnifiedPush endpoint origins are explicitly allowed; no public arbitrary push URLs.
PUSH_ALLOWED_ORIGINS=http://127.0.0.1:8090
# APNs runs directly over HTTP/2; no Firebase service is used. Keep .p8 keys outside Git.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=org.bindubashini.bloodconnection
APNS_SANDBOX=1
